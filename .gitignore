# Per-seed training logs from scripts/seed_sweep.py. They exist so a sweep in
# flight can be followed with `tail -f` -- a twenty-minute job with no visible
# progress is indistinguishable from a hung one. The results are the committed
# .md and .json reports beside them; a progress log is not evidence.
reports/sweeps/*.log

# Progress logs. They exist so a twenty-minute run can be followed with
# `tail -f`, and a log is not evidence. Reports are committed: the sweeps under
# reports/sweeps/ are the data behind that directory's tables.
reports/**/*.log

# reports/iso/ is the one exception, and for a specific reason rather than a
# policy: those weights were trained before two defects in the calibration
# layer were found, so the reports their training runs wrote describe a rule
# that no longer exists. `scripts/regate.py` writes `-regated.md` reports from
# the current rule against the same weights, and those are committed instead.
# Publishing two reports about one set of weights that disagree about its
# calibration is worse than publishing one.
reports/iso/iso-seed?.md
reports/iso/iso-seed?.json
reports/iso/iso-seed?-training.json
reports/iso/iso-seed?-temperatures.json
reports/iso/iso-seed?-isotonic.json

# Fetched corpora. Someone else's data, cached on first use and never
# committed: a checked-in copy is a second source of truth that goes stale
# silently. `trigon.evals.corpora` records provenance and attribution instead.
corpora/

# The GitHub Pages site, rendered by scripts/build_site.py. Generated from
# docs/, reports/ and spec/ on every deploy and never committed.
_site/

# Agent worktrees
.claude/worktrees/
