{
  "name": "@howlerops/trigon-client",
  "version": "0.1.0",
  "description": "Typed, calibrated decisions from the Trigon API. Generated from the OpenAPI contract; no runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/generated.js",
  "types": "dist/generated.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/generated.d.ts",
      "import": "./dist/generated.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlerops/trigon.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://howlerops.github.io/trigon/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
